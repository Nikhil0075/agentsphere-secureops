{
  "$defs": {
    "AgentRunRecord": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "backend": {
          "default": "",
          "title": "Backend",
          "type": "string"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "output_hash": {
          "default": "",
          "title": "Output Hash",
          "type": "string"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "default": "",
          "title": "Trace Id",
          "type": "string"
        },
        "validation_error": {
          "default": "",
          "title": "Validation Error",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "sequence",
        "status"
      ],
      "title": "AgentRunRecord",
      "type": "object"
    },
    "BaselinePrediction": {
      "additionalProperties": false,
      "description": "The non-LLM comparison point (\u00a76). Kept separate from agent output so the two can never be\nconflated when metrics are reported.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/TriageLabel"
        },
        "model_name": {
          "default": "",
          "title": "Model Name",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "BaselinePrediction",
      "type": "object"
    },
    "CorrelationOutput": {
      "additionalProperties": false,
      "description": "Input: evidence and related alerts.",
      "properties": {
        "evidence_bundle": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Bundle",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "maxItems": 15,
          "title": "Missing Information",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "maxItems": 40,
          "title": "Relationships",
          "type": "array"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "maxItems": 40,
          "title": "Timeline",
          "type": "array"
        }
      },
      "required": [
        "evidence_bundle",
        "relationships",
        "timeline",
        "missing_information"
      ],
      "title": "CorrelationOutput",
      "type": "object"
    },
    "DetectionOutput": {
      "additionalProperties": false,
      "description": "Input: raw incident fields and detector metadata.",
      "properties": {
        "initial_reason": {
          "maxLength": 1200,
          "title": "Initial Reason",
          "type": "string"
        },
        "severity_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity Score",
          "type": "number"
        },
        "suspicious_entities": {
          "items": {
            "$ref": "#/$defs/SuspiciousEntity"
          },
          "maxItems": 25,
          "title": "Suspicious Entities",
          "type": "array"
        }
      },
      "required": [
        "severity_score",
        "suspicious_entities",
        "initial_reason"
      ],
      "title": "DetectionOutput",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "description": "Not an LLM output \u2014 the analyst's recorded decision on a high-risk recommendation.",
      "properties": {
        "analyst": {
          "title": "Analyst",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "comment": {
          "maxLength": 1000,
          "title": "Comment",
          "type": "string"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "approved",
        "comment",
        "analyst"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "InvestigationOutput": {
      "additionalProperties": false,
      "description": "Input: evidence bundle plus retrieved incidents.",
      "properties": {
        "investigation_summary": {
          "maxLength": 2000,
          "title": "Investigation Summary",
          "type": "string"
        },
        "mitre_mapping": {
          "items": {
            "$ref": "#/$defs/MitreMapping"
          },
          "maxItems": 10,
          "title": "Mitre Mapping",
          "type": "array"
        },
        "similar_cases": {
          "items": {
            "$ref": "#/$defs/SimilarCase"
          },
          "maxItems": 10,
          "title": "Similar Cases",
          "type": "array"
        }
      },
      "required": [
        "similar_cases",
        "mitre_mapping",
        "investigation_summary"
      ],
      "title": "InvestigationOutput",
      "type": "object"
    },
    "MitreMapping": {
      "additionalProperties": false,
      "properties": {
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "technique_id": {
          "maxLength": 16,
          "title": "Technique Id",
          "type": "string"
        },
        "technique_name": {
          "maxLength": 160,
          "title": "Technique Name",
          "type": "string"
        }
      },
      "required": [
        "technique_id",
        "technique_name",
        "supporting_evidence_ids"
      ],
      "title": "MitreMapping",
      "type": "object"
    },
    "PolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 400,
          "title": "Detail",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "passed",
        "detail"
      ],
      "title": "PolicyCheck",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "maxLength": 120,
          "title": "Relation",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relation"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RemediationOutput": {
      "additionalProperties": false,
      "description": "Input: triage result plus policy catalogue. Every action is simulated.",
      "properties": {
        "action_risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "justification": {
          "maxLength": 1500,
          "title": "Justification",
          "type": "string"
        },
        "recommended_action": {
          "maxLength": 120,
          "title": "Recommended Action",
          "type": "string"
        },
        "rollback_plan": {
          "maxLength": 1000,
          "title": "Rollback Plan",
          "type": "string"
        }
      },
      "required": [
        "recommended_action",
        "action_risk",
        "rollback_plan",
        "justification"
      ],
      "title": "RemediationOutput",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SimilarCase": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "similarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Similarity",
          "type": "number"
        },
        "why_similar": {
          "maxLength": 400,
          "title": "Why Similar",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "similarity",
        "why_similar"
      ],
      "title": "SimilarCase",
      "type": "object"
    },
    "SuspiciousEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "enum": [
            "account",
            "device",
            "ip",
            "filehash",
            "url",
            "process",
            "mailbox"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "value",
        "reason"
      ],
      "title": "SuspiciousEntity",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "description",
        "evidence_id"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "TriageLabel": {
      "enum": [
        "TruePositive",
        "BenignPositive",
        "FalsePositive"
      ],
      "title": "TriageLabel",
      "type": "string"
    },
    "TriageOutput": {
      "additionalProperties": false,
      "description": "Input: investigation output plus baseline score.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/TriageLabel"
        },
        "rationale": {
          "maxLength": 1500,
          "title": "Rationale",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "label",
        "confidence",
        "rationale",
        "supporting_evidence_ids"
      ],
      "title": "TriageOutput",
      "type": "object"
    },
    "VerifierOutput": {
      "additionalProperties": false,
      "description": "Input: all prior outputs. This agent may reject its own team.",
      "properties": {
        "contradictions": {
          "items": {
            "type": "string"
          },
          "maxItems": 15,
          "title": "Contradictions",
          "type": "array"
        },
        "escalation_required": {
          "title": "Escalation Required",
          "type": "boolean"
        },
        "policy_checks": {
          "items": {
            "$ref": "#/$defs/PolicyCheck"
          },
          "maxItems": 20,
          "title": "Policy Checks",
          "type": "array"
        },
        "reasoning": {
          "maxLength": 1500,
          "title": "Reasoning",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/VerifierVerdict"
        }
      },
      "required": [
        "verdict",
        "contradictions",
        "policy_checks",
        "escalation_required",
        "reasoning"
      ],
      "title": "VerifierOutput",
      "type": "object"
    },
    "VerifierVerdict": {
      "enum": [
        "accept",
        "reject",
        "escalate"
      ],
      "title": "VerifierVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The single object the orchestrator threads through every node.",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselinePrediction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorrelationOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_clusters": {
      "default": 0,
      "title": "Correlation Clusters",
      "type": "integer"
    },
    "detection": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetectionOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "evidence_hash": {
      "default": "",
      "title": "Evidence Hash",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "incident_summary": {
      "default": "",
      "title": "Incident Summary",
      "type": "string"
    },
    "investigation": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvestigationOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_hash": {
      "default": "",
      "title": "Output Hash",
      "type": "string"
    },
    "remediation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemediationOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requires_approval": {
      "default": false,
      "title": "Requires Approval",
      "type": "boolean"
    },
    "risk_score": {
      "default": 0.0,
      "title": "Risk Score",
      "type": "number"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/AgentRunRecord"
      },
      "title": "Runs",
      "type": "array"
    },
    "triage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TriageOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifierOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "incident_id"
  ],
  "title": "WorkflowState",
  "type": "object"
}
