# Copy to .env and fill in. .env is git-ignored.

# --- LLM ---
# replay        = validated cache only; a miss safely falls back without any network request
# live          = OpenAI Agents SDK via the Responses API (needs OPENAI_API_KEY)
# deterministic = rule-based agents, no network, no key. Demo fallback path.
# Compatibility aliases: cache -> replay, openai -> live.
LLM_BACKEND=replay
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.6-terra
OPENAI_JUDGE_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
AGENT_PROMPT_VERSION=2026-08-09
# Opt in only when the machine can reach the OpenAI trace exporter.
AGENT_TRACING_ENABLED=false
AGENT_TRACE_INCLUDE_SENSITIVE=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# --- data ---
# fixture = synthetic GUIDE-schema data, always available
# guide   = the real Microsoft GUIDE dataset at GUIDE_PATH
DATA_SOURCE=fixture
GUIDE_PATH=
DEMO_INCIDENT_COUNT=200

# --- storage ---
DB_PATH=artifacts/agentsphere.db

# --- kaggle (only needed for scripts/download_data.py) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
