# Copy to .env and fill in. .env is git-ignored.

# --- LLM ---
# openai        = live API calls (needs OPENAI_API_KEY)
# cache         = replay only from artifacts/llm_cache; fails if a prompt is not cached
# deterministic = rule-based agents, no network, no key. Demo fallback path.
LLM_BACKEND=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# --- data ---
# fixture = synthetic GUIDE-schema data, always available
# guide   = the real Microsoft GUIDE dataset at GUIDE_PATH
DATA_SOURCE=fixture
GUIDE_PATH=
DEMO_INCIDENT_COUNT=200

# --- storage ---
DB_PATH=artifacts/agentsphere.db

# --- kaggle (only needed for scripts/download_data.py) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
