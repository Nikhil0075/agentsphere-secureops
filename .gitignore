.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# Data is never committed — scripts/prepare_data.py regenerates it deterministically.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated artifacts. Metrics and schemas ARE committed (they are evidence); models and
# caches are not.
artifacts/models/*
artifacts/llm_cache/*
!artifacts/**/.gitkeep

*.db
*.db-wal
*.db-shm
*.log
.DS_Store

# Contract toolchain and build output
contracts/node_modules/
contracts/cache/
contracts/artifacts/
contracts/typechain-types/
contracts/dist/

# Deployment records contain throwaway agent keys; addresses go in the README instead.
artifacts/chain/

# Frontend
frontend/node_modules/
frontend/dist/

# WitFoo Precinct6 raw download (~442 MB) and its reduction. Regenerate with
# scripts/download_witfoo.py then scripts/build_witfoo_graph.py.
data/raw/witfoo/
artifacts/witfoo/
